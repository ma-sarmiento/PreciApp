<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#F7F4EF">  <!-- fondo tipo mockup -->

    <!-- Logo -->
    <ImageView
        android:id="@+id/logo"
        android:layout_width="wrap_content"
        android:layout_height="100sp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="44dp"
        app:srcCompat="@drawable/carrito_de_compras" />

    <!-- Título grande -->
    <TextView
        android:id="@+id/tvTituloApp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PresiApp"
        android:textStyle="bold"
        android:textSize="32sp"
        android:textColor="#101828"
        android:layout_below="@id/logo"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp" />

    <!-- Nombre -->
    <EditText
        android:id="@+id/editTextNombre"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@id/tvTituloApp"
        android:layout_marginTop="26dp"
        android:hint="Nombre"
        android:inputType="textPersonName"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:drawableStart="@android:drawable/ic_menu_myplaces"
        android:drawablePadding="10dp"
        android:textColor="#101828"
        android:textColorHint="#6B7280"
        android:backgroundTint="#FFFFFFFF" />

    <!-- Correo -->
    <EditText
        android:id="@+id/editTextCorreo"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@id/editTextNombre"
        android:layout_marginTop="12dp"
        android:hint="Correo Electrónico"
        android:inputType="textEmailAddress"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:drawableStart="@android:drawable/ic_dialog_email"
        android:drawablePadding="10dp"
        android:textColor="#101828"
        android:textColorHint="#6B7280"
        android:backgroundTint="#FFFFFFFF" />

    <!-- Usuario -->
    <EditText
        android:id="@+id/editTextUsuario"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@id/editTextCorreo"
        android:layout_marginTop="12dp"
        android:hint="Usuario"
        android:inputType="text"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:drawableStart="@android:drawable/ic_menu_myplaces"
        android:drawablePadding="10dp"
        android:textColor="#101828"
        android:textColorHint="#6B7280"
        android:backgroundTint="#FFFFFFFF" />

    <!-- Contraseña -->
    <EditText
        android:id="@+id/editTextContraseña"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@id/editTextUsuario"
        android:layout_marginTop="12dp"
        android:hint="Contraseña"
        android:inputType="textPassword"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:drawableStart="@android:drawable/ic_lock_lock"
        android:drawablePadding="10dp"
        android:textColor="#101828"
        android:textColorHint="#6B7280"
        android:backgroundTint="#FFFFFFFF" />

    <!-- Botón Registrarme (MISMO ID) como MaterialButton para estilo mockup -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonRegistrarme"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@id/editTextContraseña"
        android:layout_marginTop="20dp"
        android:text="Registrarme"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:textColor="#FFFFFFFF"
        app:cornerRadius="24dp"
        app:backgroundTint="@color/purple_500" />

    <!-- Enlace Volver al login -->
    <TextView
        android:id="@+id/textViewVolverLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/buttonRegistrarme"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="18dp"
        android:text="Ya tengo una cuenta"
        android:textColor="@color/purple_500"
        android:textSize="14sp"
        android:gravity="center" />
</RelativeLayout>