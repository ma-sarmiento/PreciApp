<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F2FF"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 🔹 ESPACIADOR PARA EVITAR QUE LA CÁMARA/NOTCH TAPE EL HEADER -->
        <View
            android:layout_width="match_parent"
            android:layout_height="32dp" />

        <!-- 🔹 HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/circle_background"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="#6A4CC3"
                android:contentDescription="Volver" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Definir presupuesto"
                android:textColor="#4C2FAF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center" />

            <View
                android:layout_width="40dp"
                android:layout_height="40dp" />
        </LinearLayout>

        <!-- 🔹 TARJETA BLANCA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/rounded_box_white"
            android:elevation="5dp"
            android:gravity="center_horizontal">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_wallet"
                android:tint="#6A4CC3"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ingrese su presupuesto total"
                android:textColor="#555555"
                android:textSize="14sp"
                android:layout_marginBottom="16dp"/>

            <EditText
                android:id="@+id/editTextPresupuesto"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/rounded_box_white"
                android:paddingHorizontal="16dp"
                android:textColor="#000000"
                android:textColorHint="#888888"
                android:hint="$ 0"
                android:inputType="numberDecimal"
                android:elevation="2dp"
                android:layout_marginBottom="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonConfirmarPresupuesto"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Confirmar"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                app:cornerRadius="20dp"
                app:backgroundTint="#6A4CC3" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
