<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="10dp"
    app:cardCornerRadius="16dp"
    app:cardUseCompatPadding="true"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Icono -->
        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_barcode"
            app:tint="@color/purple_500"
            android:contentDescription="@null"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <!-- Nombre -->
        <TextView
            android:id="@+id/tvNombre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Nombre"
            android:textStyle="bold"
            android:textColor="#101828"
            android:textSize="16sp"
            app:layout_constraintStart_toEndOf="@id/ivIcon"
            app:layout_constraintEnd_toStartOf="@id/groupStepper"
            app:layout_constraintTop_toTopOf="@id/ivIcon"
            app:layout_constrainedWidth="true"/>

        <!-- Marca • Categoría -->
        <TextView
            android:id="@+id/tvMarcaCategoria"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="2dp"
            android:text="Marca • Categoría"
            android:textColor="#6B7280"
            android:textSize="13sp"
            app:layout_constraintStart_toEndOf="@id/ivIcon"
            app:layout_constraintEnd_toStartOf="@id/groupStepper"
            app:layout_constraintTop_toBottomOf="@id/tvNombre"/>

        <!-- Precio -->
        <TextView
            android:id="@+id/tvPrecio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="$ 0"
            android:textColor="#6B7280"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="@id/tvMarcaCategoria"
            app:layout_constraintTop_toBottomOf="@id/tvMarcaCategoria"/>

        <!-- STEPper (– 0 +) a la derecha -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/groupStepper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- – -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMenos"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="–"
                android:textStyle="bold"
                android:textSize="22sp"
                android:includeFontPadding="false"
                app:cornerRadius="22dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/purple_500"
                app:backgroundTint="@android:color/white"
                app:iconPadding="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <!-- Cantidad -->
            <TextView
                android:id="@+id/tvCantidad"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:gravity="center"
                android:text="0"
                android:textStyle="bold"
                android:textColor="#101828"
                android:textSize="16sp"
                app:layout_constraintStart_toEndOf="@id/btnMenos"
                app:layout_constraintTop_toTopOf="@id/btnMenos"
                app:layout_constraintBottom_toBottomOf="@id/btnMenos"/>

            <!-- + -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMas"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:text="+"
                android:textStyle="bold"
                android:textSize="22sp"
                android:includeFontPadding="false"
                app:cornerRadius="22dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/purple_500"
                app:backgroundTint="@android:color/white"
                app:iconPadding="0dp"
                app:layout_constraintStart_toEndOf="@id/tvCantidad"
                app:layout_constraintTop_toTopOf="@id/btnMenos"
                app:layout_constraintBottom_toBottomOf="@id/btnMenos"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
